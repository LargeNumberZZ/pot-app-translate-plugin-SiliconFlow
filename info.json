{
  "id": "plugin.com.pot-app.siliconflow",
  "plugin_type": "translate",
  "icon": "siliconflow.svg",
  "display": "硅基流动 SiliconFlow",
  "homepage": "https://github.com/LargeNumberZZ/pot-app-translate-plugin-SiliconFlow",
  "needs": [
    {
      "key": "apiKey",
      "display": "API Key",
      "type": "input"
    },
    {
      "key": "mode",
      "display": "翻译模式",
      "type": "select",
      "options": {
        "auto": "智能模式（单词：混元快速译文 + Qwen 词典卡片；句子：混元翻译）",
        "dual": "双模型对照",
        "hunyuan": "全部由 Hunyuan-MT-7B 输出（快速译文 / 词典 / 翻译）",
        "qwen": "全部由 Qwen2.5-7B 输出（快速译文 / 词典 / 翻译）"
      }
    },
    {
      "key": "dictMode",
      "display": "词典模式",
      "type": "select",
      "options": {
        "auto": "自动判断（单词/短语/固定搭配按词典输出，句子直接翻译）",
        "always": "总是按词典格式输出",
        "never": "总是直接输出译文"
      }
    },
    {
      "key": "promptWord",
      "display": "词典模式 Prompt（留空用默认）",
      "type": "input"
    },
    {
      "key": "promptSentence",
      "display": "句子翻译 Prompt（留空用默认）",
      "type": "input"
    },
    {
      "key": "promptSystem",
      "display": "System Prompt（留空用默认）",
      "type": "input"
    },
    {
      "key": "apiUrl",
      "display": "API 地址（留空用官方默认）",
      "type": "input"
    }
  ],
  "language": {
    "auto": "auto",
    "zh_cn": "zh",
    "zh_tw": "zh_HANT",
    "en": "en",
    "ja": "ja",
    "ko": "ko",
    "fr": "fr",
    "es": "es",
    "ru": "ru",
    "de": "de",
    "it": "it",
    "tr": "tr",
    "pt_pt": "pt",
    "pt_br": "pt",
    "vi": "vi",
    "id": "id",
    "th": "th",
    "ms": "ms",
    "ar": "ar",
    "hi": "hi",
    "mn_cy": "mn",
    "mn_mo": "mn",
    "km": "km",
    "nb_no": "no",
    "nn_no": "no",
    "fa": "fa"
  }
}
